        ]
      }
    ],
    "relationships": [
      {
        "name": "fact_to_stock",
        "fromTable": "fact_prices",
        "fromColumn": "ticker",
        "toTable": "dim_stock",
        "toColumn": "ticker"
      }
    ],
    "annotations": [
